Вася:
<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Адмінка — Топорига</title>
<style>
body { font-family: system-ui, sans-serif; padding: 15px; max-width: 480px; margin: 0 auto; background: #f4f4f9; }
.card { background: white; padding: 20px; border-radius: 12px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
input, button { width: 100%; padding: 12px; margin: 6px 0; border-radius: 8px; border: 1px solid #ccc; box-sizing: border-box; font-size: 16px; }
button { background: #007bff; color: white; border: none; font-weight: bold; cursor: pointer; }
.hidden { display: none; }
.stat-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #eee; }
.logout-btn { background: #dc3545; margin-top: 15px; }
</style>
</head>
<body>

<!-- 1. ФОРМА ВХОДУ ДЛЯ ТЕЛЕФОНУ -->
<div id="login-sec" class="card">
<h2>🔑 Вхід в адмінку</h2>
<input type="email" id="email" placeholder="Ваш Email">
<input type="password" id="pass" placeholder="Пароль">
<button id="login-btn">Увійти</button>
</div>

<!-- 2. АДМІН-ПАНЕЛЬ (ДОДАТИ КАВУ ТА СТАТИСТИКА) -->
<div id="admin-sec" class="card hidden">
<h2>☕ Додати нову каву</h2>
<input type="text" id="title" placeholder="Назва (напр. Лате)">
<input type="number" id="price" placeholder="Ціна (грн)">
<input type="text" id="desc" placeholder="Опис">
<input type="text" id="img" placeholder="URL фото (необов'язково)">
<button id="add-btn">Додати в меню</button>

<hr style="margin: 25px 0;">

<h2>📊 Статистика переглядів</h2>
<div id="stats-list">Завантаження...</div>

<button id="logout-btn" class="logout-btn">Вийти</button>
</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
import { getAuth, signInWithEmailAndPassword, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
import { getFirestore, collection, addDoc, onSnapshot, query, orderBy } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

// ⚠️ ВСТАВТЕ СВОЇ ДАНІ З FIREBASE (Project Settings -> General)
const firebaseConfig = {
apiKey: "ВАШ_API_KEY",
authDomain: "toropyga.firebaseapp.com",
projectId: "toropyga",
storageBucket: "toropyga.appspot.com",
messagingSenderId: "ВАШ_SENDER_ID",
appId: "ВАШ_APP_ID"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

// Перевірка стану входу
onAuthStateChanged(auth, (user) => {
if (user) {
document.getElementById('login-sec').classList.add('hidden');
document.getElementById('admin-sec').classList.remove('hidden');
loadStats();
} else {
document.getElementById('login-sec').classList.remove('hidden');
document.getElementById('admin-sec').classList.add('hidden');
}
});

// Авторизація
document.getElementById('login-btn').addEventListener('click', async () => {
const email = document.getElementById('email').value;
const pass = document.getElementById('pass').value;
try {
await signInWithEmailAndPassword(auth, email, pass);
} catch (err) {
alert("Помилка входу: " + err.message);
}
});

// Вихід з адмінки
document.getElementById('logout-btn').addEventListener('click', () => signOut(auth));

// Додавання кави
document.getElementById('add-btn').addEventListener('click', async () => {
const title = document.getElementById('title').value;
const price = Number(document.getElementById('price').value);
const desc = document.getElementById('desc').value;
const img = document.getElementById('img').value;

if (!title || !price) return alert("Заповніть назву та ціну!");

Вася:
try {
await addDoc(collection(db, "coffee"), {
title: title,
price: price,
description: desc,
image: img || "https://via.placeholder.com/150",
views: 0
});
alert("Каву успішно додано!");
document.getElementById('title').value = '';
document.getElementById('price').value = '';
document.getElementById('desc').value = '';
document.getElementById('img').value = '';
} catch (err) {
alert("Помилка додавання: " + err.message);
}
});

// Оновлення статистики в реальному часі
function loadStats() {
const q = query(collection(db, "coffee"), orderBy("views", "desc"));
onSnapshot(q, (snapshot) => {
const list = document.getElementById('stats-list');
list.innerHTML = '';
snapshot.forEach((doc) => {
const data = doc.data();
const row = document.createElement('div');
row.className = 'stat-row';
row.innerHTML = <span><strong>${data.title}</strong> (${data.price} грн)</span> <span>👁️ ${data.views || 0}</span>;
list.appendChild(row);
});
});
}
</script>
</body>
</html>
